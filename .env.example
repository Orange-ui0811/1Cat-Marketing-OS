COMPOSE_PROJECT_NAME=1cat-hermes-os
# Keep docker.io for normal environments. Set a trusted pull-through mirror
# only when Docker Hub is unreachable; digest pins still verify every image.
DOCKER_HUB_REGISTRY=docker.io
# Hermes is large enough that some mirrors only cache part of it; this can use
# a separate trusted registry while the pinned upstream digest remains fixed.
HERMES_IMAGE_REGISTRY=docker.io
PUBLIC_BASE_URL=http://localhost:8080
POSTGRES_DB=onecat
POSTGRES_USER=onecat
POSTGRES_PASSWORD=onecat-local-change-me
MINIO_ROOT_USER=onecat
MINIO_ROOT_PASSWORD=onecat-local-change-me
KEYCLOAK_ADMIN=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=onecat-local-change-me
INITIAL_ADMIN_PASSWORD=
ORG_MCP_CLIENT_SECRET=
OIDC_ISSUER=http://localhost:8080/auth/realms/1cat
OIDC_JWKS_URL=http://keycloak:8080/auth/realms/1cat/protocol/openid-connect/certs
AUTH_MODE=oidc
HERMES_EXECUTION_ENABLED=false
HERMES_MODEL_PROVIDER=deepseek
HERMES_MODEL_ID=deepseek-v4-pro
HERMES_API_KEY_PMA=local-pma-change-me
HERMES_API_KEY_BGA=local-bga-change-me
HERMES_API_KEY_MO=local-mo-change-me
MODEL_MODE=deepseek-api-key
MODEL_API_KEY_FILE=/run/secrets/model_api_key
MODEL_GATEWAY_CLIENT_TOKEN=
MODEL_UPSTREAM_BASE_URL=https://api.deepseek.com
MODEL_UPSTREAM_TIMEOUT_SECONDS=900
RUN_LEASE_SECONDS=30
HERMES_POLL_SECONDS=2
HERMES_MAX_POLLS=360
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_RETRY_INITIAL_SECONDS=1
DATABASE_RETRY_MAX_SECONDS=10
RUN_HEARTBEAT_SECONDS=10
RUN_RECOVERY_SCAN_SECONDS=5
RUN_MAX_ATTEMPTS=2
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=onecat-observe
