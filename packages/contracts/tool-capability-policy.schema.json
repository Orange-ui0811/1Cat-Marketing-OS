{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1cat.local/contracts/tool-capability-policy/1.0.0",
  "title": "ToolCapabilityPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "role_id",
    "profile_id",
    "service_identity_id",
    "capabilities",
    "effect"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "role_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "service_identity_id": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array"
    },
    "effect": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "conditions": {
      "type": "object"
    }
  }
}
